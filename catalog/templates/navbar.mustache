                    <div class="cv-drawer__avatar" id="drawer-avatar">{{initals}}</div>
                    <div class="cv-drawer__user-info">
                        <strong id="drawer-name">Hola, {{username}}</strong>
                        <small>{{#str}}welcomeback, local_catalog{{/str}}</small>
