                <div class="cv-drawer__auth" id="drawer-auth">
                    <a href="#login" class="cv-drawer__auth-btn cv-drawer__auth-btn--outline">{{#str}}login, local_catalog{{/str}}</a>
                    <a href="#register" class="cv-drawer__auth-btn cv-drawer__auth-btn--primary">{{#str}}register, local_catalog{{/str}}</a>
