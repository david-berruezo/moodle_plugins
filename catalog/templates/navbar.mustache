<!-- ═══ DESKTOP ══════════════════════════════════════════════════════════════ -->
<header class="cv-header" role="banner">
    <div class="cv-header__inner">
        <a href="{{homeurl}}" class="cv-header__logo">
            <div class="cv-header__logo-mark">A</div>
            <span class="cv-header__logo-text">Campus Virtual</span>
        </a>

        {{! ── Desktop: mega-menú Explorar ── }}
        <div class="cv-popper" id="cv-p-explore" data-trigger="hover">
            <button class="cv-header__nav-btn"
                    aria-expanded="false"
                    aria-haspopup="true"
                    aria-controls="cv-explore-menu">
                {{#str}}explore, local_catalog{{/str}}
                <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                     stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                    <path d="M6 9l6 6 6-6"/>
                </svg>
            </button>

            <div class="cv-popper__content cv-popper__content--explore" id="cv-explore-menu" role="menu">
                {{#has_menu}}
                    <div class="cv-explore">

                        {{! ── Columna izquierda: triggers de nivel 1 ── }}
                        <div class="cv-explore__col cv-explore__col--main">

                            {{! Enlace directo: todos los cursos }}
                            <div class="cv-explore__heading">{{#str}}categories, local_catalog{{/str}}</div>
                            <ul class="cv-explore__list">
                                {{#menu_triggers}}
                                    <li>
                                        {{#has_subcats}}
                                        {{! Categoría con hijos → botón trigger que abre el panel }}
                                            <button class="cv-explore__item cv-explore__item--trigger"
                                                    data-cat="{{data_key}}"
                                                    aria-expanded="false"
                                                    aria-controls="cv-sub-{{data_key}}">
                                                {{name}}
                                                <svg viewBox="0 0 24 24" width="10" height="10" fill="none"
                                                     stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                                    <path d="M9 18l6-6-6-6"/>
                                                </svg>
                                            </button>
                                        {{/has_subcats}}
                                        {{^has_subcats}}
                                        {{! Categoría hoja → enlace directo }}
                                            <a href="{{url}}" class="cv-explore__item">{{name}}</a>
                                        {{/has_subcats}}
                                    </li>
                                {{/menu_triggers}}

                                <li>
                                    <a href="{{catalogurl}}" class="cv-explore__item cv-explore__item--see">
                                        {{#str}}allcourses, local_catalog{{/str}} →
                                    </a>
                                </li>

                            </ul>
                        </div>

                        {{! ── Columna derecha: paneles de cada categoría nivel 1 ── }}
                        <div class="cv-explore__col cv-explore__col--sub" id="cv-explore-sub">

                            {{#menu_panels}}
                                <div class="cv-explore__sub" id="cv-sub-{{data_key}}">

                                    {{! ── El panel tiene subcategorías de nivel 2 ── }}
                                    {{#has_subcats}}
                                        {{#subcats}}
                                            <div class="cv-explore__subgroup">

                                                {{! Cabecera nivel 2: enlace a la categoría }}
                                                <a href="{{url}}" class="cv-explore__heading cv-explore__heading--link">
                                                    {{name}}
                                                </a>

                                                {{! Subcategorías de nivel 3 }}
                                                {{#has_subcats}}
                                                    <ul class="cv-explore__list">
                                                        {{#subcats}}
                                                            <li>
                                                                <a href="{{url}}" class="cv-explore__item">
                                                                    {{name}}
                                                                    {{#has_courses}}
                                                                        <span class="cv-explore__count">({{coursecount}})</span>
                                                                    {{/has_courses}}
                                                                </a>
                                                                {{! Cursos dentro del nivel 3 — visible en hover/click }}
                                                                {{#has_courses}}
                                                                    <ul class="cv-explore__courses">
                                                                        {{#courses}}
                                                                            <li>
                                                                                <a href="{{courseurl}}" class="cv-explore__course">
                                                                                    <svg viewBox="0 0 24 24" width="12" height="12" fill="none"
                                                                                         stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                                                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                                                                        <polyline points="14 2 14 8 20 8"/>
                                                                                    </svg>
                                                                                    {{fullname}}
                                                                                </a>
                                                                            </li>
                                                                        {{/courses}}
                                                                    </ul>
                                                                {{/has_courses}}
                                                            </li>
                                                        {{/subcats}}
                                                    </ul>
                                                {{/has_subcats}}

                                                {{! Nivel 2 tiene cursos directos (sin pasar por nivel 3) }}
                                                {{^has_subcats}}
                                                    {{#has_courses}}
                                                        <ul class="cv-explore__list">
                                                            {{#courses}}
                                                                <li>
                                                                    <a href="{{courseurl}}" class="cv-explore__item cv-explore__item--course">
                                                                        {{fullname}}
                                                                    </a>
                                                                </li>
                                                            {{/courses}}
                                                        </ul>
                                                    {{/has_courses}}
                                                {{/has_subcats}}

                                            </div>
                                        {{/subcats}}
                                    {{/has_subcats}}

                                    {{! ── El panel nivel 1 tiene cursos directos (sin nivel 2) ── }}
                                    {{^has_subcats}}
                                        {{#has_courses}}
                                            <ul class="cv-explore__list">
                                                {{#courses}}
                                                    <li>
                                                        <a href="{{courseurl}}" class="cv-explore__item cv-explore__item--course">
                                                            {{fullname}}
                                                        </a>
                                                    </li>
                                                {{/courses}}
                                            </ul>
                                        {{/has_courses}}
                                    {{/has_subcats}}

                                </div>
                            {{/menu_panels}}

                        </div>{{! /col--sub }}

                    </div>{{! /cv-explore }}
                {{/has_menu}}

                {{! Fallback si no hay categorías configuradas }}
                {{^has_menu}}
                    <div class="cv-explore cv-explore--empty">
                        <a href="{{catalogurl}}" class="cv-explore__item">
                            {{#str}}allcourses, local_catalog{{/str}} →
                        </a>
                    </div>
                {{/has_menu}}

            </div>{{! /cv-popper__content }}
        </div>{{! /cv-popper }}

        <a href="plan-personal.html" class="cv-header__nav-btn">Plan Personal</a>

        <div class="cv-header__search">
            <form class="cv-header__search-form" action="{{searchaction}}" method="get" role="search">
                <input type="text" name="q" class="cv-header__search-input" placeholder="Buscar cualquier cosa" aria-label="Buscar">
                <button type="submit" class="cv-header__search-btn" aria-label="Buscar">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                </button>
            </form>
        </div>

        <div class="cv-header__right">
            <div class="cv-popper" data-trigger="hover">
                <a href="comparar-planes.html" class="cv-header__nav-btn">Campus Empresarial</a>
                <div class="cv-popper__content cv-popper__content--right cv-popper__content--panel">
                    <div class="cv-panel"><div class="cv-panel__list">
                        <a href="comparar-planes.html" class="cv-panel__item">Comparar planes</a>
                        <a href="solicitar-demo.html" class="cv-panel__item">Solicitar demo</a>
                    </div></div>
                </div>
            </div>
            <div class="cv-popper" data-trigger="hover">
                <a href="enseña-aqui.html" class="cv-header__nav-btn">Enseña aquí</a>
                <div class="cv-popper__content cv-popper__content--right cv-popper__content--panel">
                    <div class="cv-panel"><div class="cv-panel__promo">
                        <p>Comparte tu conocimiento con el campus.</p>
                        <a href="enseña-aqui.html" class="cv-panel__cta">Más información</a>
                    </div></div>
                </div>
            </div>
            <div class="cv-popper" data-trigger="hover" id="nav-mylearning" style="display:none">
                <a href="#" class="cv-header__nav-btn">Mi aprendizaje</a>
                <div class="cv-popper__content cv-popper__content--right cv-popper__content--panel">
                    <div class="cv-panel">
                        <div class="cv-panel__course">
                            <div class="cv-panel__thumb" style="background:linear-gradient(135deg,#F05A28,#C94820);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:700;font-size:1.8rem;">R</div>
                            <div class="cv-panel__course-info">
                                <span class="cv-panel__course-title">React JS desde cero</span>
                                <div class="cv-panel__meter"><div class="cv-panel__meter-fill" style="--p:32%"></div></div>
                            </div>
                        </div>
                        <a href="#" class="cv-panel__cta">Ir a Mi aprendizaje</a>
                    </div>
                </div>
            </div>
            <div id="nav-guest-btns">
                <a href="login.html" class="cv-header__btn cv-header__btn--outline">Iniciar sesión</a>
                <a href="registro.html" class="cv-header__btn cv-header__btn--primary">Registrarse</a>
            </div>
            <div class="cv-popper" data-trigger="hover" id="nav-user-menu" style="display:none">
                <a href="#" class="cv-header__icon-btn" aria-label="Mi perfil">
                    <div class="cv-header__avatar" id="nav-avatar">DB</div>
                </a>
                <div class="cv-popper__content cv-popper__content--right cv-popper__content--user">
                    <div class="cv-user">
                        <a href="#" class="cv-user__header">
                            <div class="cv-user__avatar-lg">DB</div>
                            <div class="cv-user__meta"><strong>David Berruezo</strong><span>dberruezo@aubay.es</span></div>
                        </a>
                        <ul class="cv-user__list"><li><a href="#" class="cv-user__item">Mi aprendizaje</a></li></ul>
                        <ul class="cv-user__list">
                            <li><a href="#" class="cv-user__item">Configuración de la cuenta</a></li>
                            <li><a href="#" class="cv-user__item">Perfil público</a></li>
                        </ul>
                        <ul class="cv-user__list"><li><a href="#" class="cv-user__item">Cerrar sesión</a></li></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</header>