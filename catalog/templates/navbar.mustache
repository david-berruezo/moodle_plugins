<div class="cv-mobile">
    <div class="cv-overlay" id="cv-overlay"></div>

    <!-- Drawer -->
    <nav class="cv-drawer" id="cv-drawer" role="dialog" aria-modal="true" aria-label="Menú">

        <button class="cv-drawer__close" id="cv-drawer-close" aria-label="Cerrar menú">
