{{> local_catalog/navbar }}

{{! ══════════════════════════════════════════════════════════ MAIN ══ }}
<main class="cv-auth cv-page">
    <div class="cv-auth__card">

        {{! Logo }}
        <a href="{{homeurl}}" class="cv-auth__logo">
            <div class="cv-auth__logo-mark">A</div>
            <span class="cv-auth__logo-text">Campus Virtual</span>
        </a>

        <h1 class="cv-auth__title">{{#str}}login_title, local_catalog{{/str}}</h1>
        <p class="cv-auth__sub">{{#str}}login_sub, local_catalog{{/str}}</p>

        {{! Error }}
        {{#haserror}}
            <div class="cv-auth__error" role="alert">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
                     stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="10"/>
                    <path d="M12 8v4M12 16h.01"/>
                </svg>
                {{errormsg}}
            </div>
        {{/haserror}}

        {{! Formulario }}
        <form class="cv-form" method="post" action="{{loginactionurl}}" novalidate>
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            {{#wantsurl}}
                <input type="hidden" name="wantsurl" value="{{wantsurl}}">
            {{/wantsurl}}

            <div class="cv-form__group">
                <label class="cv-form__label" for="login-username">
                    {{#str}}login_username_label, local_catalog{{/str}}
                </label>
                <input class="cv-form__input {{#haserror}}cv-form__input--error{{/haserror}}"
                       id="login-username"
                       type="text"
                       name="username"
                       value="{{username}}"
                       placeholder="{{#str}}login_username_placeholder, local_catalog{{/str}}"
                       autocomplete="username"
                       autofocus
                       required>
            </div>

            <div class="cv-form__group">
                <div class="cv-form__label-row">
                    <label class="cv-form__label" for="login-password">
                        {{#str}}login_password_label, local_catalog{{/str}}
                    </label>
                    <a href="{{forgoturl}}" class="cv-form__forgot">
                        {{#str}}login_forgot, local_catalog{{/str}}
                    </a>
                </div>
                <div class="cv-form__input-wrap">
                    <input class="cv-form__input {{#haserror}}cv-form__input--error{{/haserror}}"
                           id="login-password"
                           type="password"
                           name="password"
                           placeholder="{{#str}}login_password_placeholder, local_catalog{{/str}}"
                           autocomplete="current-password"
                           required>
                    <button type="button" class="cv-form__eye" data-toggle-password="login-password"
                            aria-label="Mostrar contraseña">
                        <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round">
                            <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                            <circle cx="12" cy="12" r="3"/>
                        </svg>
                    </button>
                </div>
            </div>

            <button type="submit" class="cv-form__submit">
                {{#str}}login, local_catalog{{/str}}
            </button>
        </form>

        <p class="cv-auth__terms">
            {{#str}}login_terms_prefix, local_catalog{{/str}}
            <a href="{{termsurl}}">{{#str}}terms, local_catalog{{/str}}</a>
            {{#str}}login_terms_and, local_catalog{{/str}}
            <a href="{{privacyurl}}">{{#str}}privacy, local_catalog{{/str}}</a>.
        </p>

        <p class="cv-auth__switch">
            {{#str}}login_no_account, local_catalog{{/str}}
            <a href="{{registerurl}}">{{#str}}register_free, local_catalog{{/str}}</a>
        </p>

    </div>
</main>

