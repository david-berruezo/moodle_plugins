{{! ── HEADER ── }}
{{> local_catalog/navbar }}

{{! ══════════════════════════════════════════════════════════ MAIN ══ }}
<main class="cv-auth cv-page">
    <div class="cv-auth__card">

        <a href="{{homeurl}}" class="cv-auth__logo">
            <div class="cv-auth__logo-mark">A</div>
            <span class="cv-auth__logo-text">Campus Virtual</span>
        </a>

        {{! ── Pantalla de ÉXITO ──────────────────────────────────────── }}
        {{#success}}
            <div class="cv-auth__success">
                <div class="cv-auth__success-icon" aria-hidden="true">
                    <svg viewBox="0 0 24 24" width="40" height="40" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                        <polyline points="22 4 12 14.01 9 11.01"/>
                    </svg>
                </div>
                <h1 class="cv-auth__title">{{#str}}reg_success_title, local_catalog{{/str}}</h1>
                <p class="cv-auth__sub">{{#str}}reg_success_sub, local_catalog{{/str}}</p>
                <a href="{{loginurl}}" class="cv-form__submit" style="display:block;text-align:center;margin-top:2.4rem;text-decoration:none">
                    {{#str}}login, local_catalog{{/str}}
                </a>
            </div>
        {{/success}}

        {{! ── Formulario de registro ─────────────────────────────────── }}
        {{^success}}

            <h1 class="cv-auth__title">{{#str}}register_title, local_catalog{{/str}}</h1>
            <p class="cv-auth__sub">{{#str}}register_sub, local_catalog{{/str}}</p>

            {{! Error general }}
            {{#hasgeneralerror}}
                <div class="cv-auth__error" role="alert">
                    <svg viewBox="0 0 24 24" width="16" height="16" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <circle cx="12" cy="12" r="10"/>
                        <path d="M12 8v4M12 16h.01"/>
                    </svg>
                    {{generalerror}}
                </div>
            {{/hasgeneralerror}}

            <form class="cv-form" method="post" action="{{registeractionurl}}" novalidate>
                <input type="hidden" name="sesskey" value="{{sesskey}}">

                {{! Nombre + Apellidos en fila }}
                <div class="cv-form__row">
                    <div class="cv-form__group">
                        <label class="cv-form__label" for="reg-firstname">
                            {{#str}}reg_firstname, local_catalog{{/str}} *
                        </label>
                        <input class="cv-form__input {{#has_firstname_error}}cv-form__input--error{{/has_firstname_error}}"
                               id="reg-firstname"
                               type="text"
                               name="firstname"
                               value="{{firstname}}"
                               placeholder="{{#str}}reg_firstname_placeholder, local_catalog{{/str}}"
                               autocomplete="given-name"
                               required>
                        {{#has_firstname_error}}
                            <span class="cv-form__hint cv-form__hint--error">{{firstname_error}}</span>
                        {{/has_firstname_error}}
                    </div>

                    <div class="cv-form__group">
                        <label class="cv-form__label" for="reg-lastname">
                            {{#str}}reg_lastname, local_catalog{{/str}} *
                        </label>
                        <input class="cv-form__input {{#has_lastname_error}}cv-form__input--error{{/has_lastname_error}}"
                               id="reg-lastname"
                               type="text"
                               name="lastname"
                               value="{{lastname}}"
                               placeholder="{{#str}}reg_lastname_placeholder, local_catalog{{/str}}"
                               autocomplete="family-name"
                               required>
                        {{#has_lastname_error}}
                            <span class="cv-form__hint cv-form__hint--error">{{lastname_error}}</span>
                        {{/has_lastname_error}}
                    </div>
                </div>

                {{! Email }}
                <div class="cv-form__group">
                    <label class="cv-form__label" for="reg-email">
                        {{#str}}reg_email, local_catalog{{/str}} *
                    </label>
                    <input class="cv-form__input {{#has_email_error}}cv-form__input--error{{/has_email_error}}"
                           id="reg-email"
                           type="email"
                           name="email"
                           value="{{email}}"
                           placeholder="{{#str}}reg_email_placeholder, local_catalog{{/str}}"
                           autocomplete="email"
                           required>
                    {{#has_email_error}}
                        <span class="cv-form__hint cv-form__hint--error">{{email_error}}</span>
                    {{/has_email_error}}
                </div>

                {{! Contraseña }}
                <div class="cv-form__group">
                    <label class="cv-form__label" for="reg-password">
                        {{#str}}reg_password, local_catalog{{/str}} *
                    </label>
                    <div class="cv-form__input-wrap">
                        <input class="cv-form__input {{#has_password_error}}cv-form__input--error{{/has_password_error}}"
                               id="reg-password"
                               type="password"
                               name="password"
                               placeholder="{{#str}}reg_password_placeholder, local_catalog{{/str}}"
                               autocomplete="new-password"
                               required>
                        <button type="button" class="cv-form__eye"
                                data-toggle-password="reg-password"
                                aria-label="{{#str}}toggle_password, local_catalog{{/str}}">
                            <svg viewBox="0 0 24 24" width="18" height="18" fill="none"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
                                <circle cx="12" cy="12" r="3"/>
                            </svg>
                        </button>
                    </div>
                    {{#has_password_error}}
                        <span class="cv-form__hint cv-form__hint--error">{{password_error}}</span>
                    {{/has_password_error}}
                    {{^has_password_error}}
                        <span class="cv-form__hint">{{#str}}reg_password_hint, local_catalog{{/str}}</span>
                    {{/has_password_error}}
                </div>

                {{! Checkbox términos }}
                <div class="cv-form__group">
                    <label class="cv-form__checkbox">
                        <input type="checkbox" name="acceptterms" value="1"
                               class="cv-form__checkbox-input
                                  {{#has_terms_error}}cv-form__checkbox-input--error{{/has_terms_error}}">
                        <span class="cv-form__checkbox-label">
                        {{#str}}reg_accept_prefix, local_catalog{{/str}}
                            <a href="{{termsurl}}" target="_blank">{{#str}}terms, local_catalog{{/str}}</a>
                            {{#str}}reg_accept_and, local_catalog{{/str}}
                            <a href="{{privacyurl}}" target="_blank">{{#str}}privacy, local_catalog{{/str}}</a>.
                    </span>
                    </label>
                    {{#has_terms_error}}
                        <span class="cv-form__hint cv-form__hint--error">{{terms_error}}</span>
                    {{/has_terms_error}}
                </div>

                {{! Checkbox marketing (opcional) }}
                <div class="cv-form__group">
                    <label class="cv-form__checkbox">
                        <input type="checkbox" name="marketing" value="1"
                               class="cv-form__checkbox-input">
                        <span class="cv-form__checkbox-label">
                            {{#str}}reg_marketing, local_catalog{{/str}}
                        </span>
                    </label>
                </div>

                <button type="submit" class="cv-form__submit">
                    {{#str}}register_cta, local_catalog{{/str}}
                </button>
            </form>

            <p class="cv-auth__switch">
                {{#str}}register_already, local_catalog{{/str}}
                <a href="{{loginurl}}">{{#str}}login, local_catalog{{/str}}</a>
            </p>

        {{/success}}

    </div>
</main>

{{! ── FOOTER ── }}
{{> local_catalog/footer_home }}