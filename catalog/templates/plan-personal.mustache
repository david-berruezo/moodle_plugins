                        <small>/ mes · facturado mensualmente</small>
                    </div>
                    <div class="cv-plan-card__features"><div class="cv-plan-card__feature"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/></svg>Acceso a +200 cursos</div><div class="cv-plan-card__feature"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/></svg>Certificados oficiales Aubay</div><div class="cv-plan-card__feature"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/></svg>Aprendizaje offline</div><div class="cv-plan-card__feature"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/></svg>Rutas de aprendizaje guiadas</div><div class="cv-plan-card__feature"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/></svg>Soporte prioritario</div><div class="cv-plan-card__feature"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/></svg>Nuevos cursos cada mes</div></div>
                    <div class="cv-plan-card__cta"><a href="registro.html">Suscribirse ahora</a></div>
                </div>
            </div>
        </div>
