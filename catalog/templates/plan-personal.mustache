                    </div>
                    <div class="cv-plan-card__features">
                        <div class="cv-plan-card__feature"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/></svg>Acceso a cursos de introducción</div>
                        <div class="cv-plan-card__feature"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M20 6L9 17l-5-5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/></svg>Sin certificados</div>
                    </div>
                    <div class="cv-plan-card__cta"><a href="registro.html">Empezar gratis</a></div>
                </div>
                <div class="cv-plan-card">
                    <div class="cv-plan-card__head">
                        <h3>Plan Personal</h3>
