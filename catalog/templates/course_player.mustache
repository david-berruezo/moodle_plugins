<nav class="cv-player-nav">
    <a href="{{homeurl}}" class="cv-player-nav__logo">
        <div class="cv-player-nav__logo-mark">A</div>
    </a>
    <div class="cv-player-nav__divider"></div>
    <span class="cv-player-nav__title">{{coursename}}</span>
    <div class="cv-player-nav__progress">
        <span class="cv-player-nav__progress-label">{{progress_percent}}% completado</span>
        <div class="cv-player-nav__progress-bar">
            <div class="cv-player-nav__progress-fill"
                 style="width:{{progress_percent}}%"></div>
        </div>
    </div>
    {{#isenrolled}}
        <button class="cv-player-nav__btn cv-player-nav__btn--primary">
            <svg viewBox="0 0 24 24" width="14" height="14">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                <polyline points="22 4 12 14.01 9 11.01"/>
            </svg>
            Dejar valoración
        </button>
    {{/isenrolled}}
    <a href="{{courseurl}}" class="cv-player-nav__btn">Volver al curso</a>
</nav>

<div class="cv-player-layout">

    {{! ── ÁREA PRINCIPAL ────────────────────────────────────────────────── }}
    <div class="cv-player-layout__main">

        {{! ── MODO ÍNDICE: listado de vídeos por secciones ───────────────── }}
        {{#show_index}}

            <div class="cv-player-index">
                <div class="cv-player-index__header">
                    <h1 class="cv-player-index__title">{{coursename}}</h1>
                    <p class="cv-player-index__meta">
                        {{progress_done}} de {{progress_total}} vídeos completados
                    </p>
                </div>

                {{#index_sections}}
                    <div class="cv-player-index__section">
                         <!--
                        <div class="cv-player-index__section-header">
                            <h2 class="cv-player-index__section-title">{{name}}</h2>
                            <span class="cv-player-index__section-count">
                                {{activitycount}} vídeos
                            </span>
                        </div>

                        <div class="cv-player-index__grid">
                            {{#activities}}
                                <a href="{{playerurl}}" class="cv-player-index__card">
                                    {{! Thumbnail o preview }}
                                    <div class="cv-player-index__thumb">
                                        {{#haspreview}}
                                            <img src="{{previewurl}}" alt="{{name}}" loading="lazy">
                                        {{/haspreview}}
                                        {{^haspreview}}
                                            <div class="cv-player-index__thumb-placeholder">
                                                <svg viewBox="0 0 24 24" width="32" height="32"
                                                     fill="none" stroke="currentColor" stroke-width="1.5">
                                                    <circle cx="12" cy="12" r="10"/>
                                                    <polygon points="10,8 16,12 10,16 10,8"
                                                             fill="currentColor" stroke="none"/>
                                                </svg>
                                            </div>
                                        {{/haspreview}}
                                        <div class="cv-player-index__thumb-overlay">
                                            <svg viewBox="0 0 24 24" width="20" height="20">
                                                <circle cx="12" cy="12" r="10"
                                                        fill="rgba(255,255,255,.9)"/>
                                                <polygon points="10,8 16,12 10,16 10,8"
                                                         fill="#F05A28"/>
                                            </svg>
                                        </div>
                                    </div>

                                    {{! Info del vídeo }}
                                    <div class="cv-player-index__card-body">
                                        <span class="cv-player-index__card-title">{{name}}</span>
                                        {{#hasdescription}}
                                            <span class="cv-player-index__card-desc">
                                                {{description}}
                                            </span>
                                        {{/hasdescription}}
                                        <span class="cv-player-index__card-type">{{typename}}</span>
                                    </div>

                                </a>
                            {{/activities}}
                        </div>
                        -->
                    </div>

                {{/index_sections}}
            </div>

        {{/show_index}}

        {{! ── MODO PLAYER: reproductor ───────────────────────────────────── }}
        {{#show_player}}

        {{! iFrame embed (YouTube, Vimeo, pluginfile) }}
            {{#is_video}}
                <div class="cv-player-video">
                    <iframe src="{{video_url}}"
                            class="lp-video__iframe"
                            frameborder="0"
                            allow="accelerometer; autoplay; clipboard-write;
                               encrypted-media; gyroscope; picture-in-picture"
                            allowfullscreen style="min-height:600px;width:100%;">
                    </iframe>
                </div>
            {{/is_video}}

            {{! Navegación anterior / siguiente }}
            <div class="cv-player-nav-controls">
                {{#hasprev}}
                    <a href="{{prevurl}}" class="cv-player-nav-controls__btn
                                             cv-player-nav-controls__btn--prev"
                       title="{{prevname}}">
                        <svg viewBox="0 0 24 24" width="16" height="16">
                            <path d="M15 18l-6-6 6-6" stroke="currentColor"
                                  stroke-width="2" stroke-linecap="round" fill="none"/>
                        </svg>
                        Anterior
                    </a>
                {{/hasprev}}
                {{#hasnext}}
                    <a href="{{nexturl}}" class="cv-player-nav-controls__btn
                                             cv-player-nav-controls__btn--next"
                       title="{{nextname}}">
                        Siguiente
                        <svg viewBox="0 0 24 24" width="16" height="16">
                            <path d="M9 18l6-6-6-6" stroke="currentColor"
                                  stroke-width="2" stroke-linecap="round" fill="none"/>
                        </svg>
                    </a>
                {{/hasnext}}
            </div>

            {{! Pestañas del player }}
            <div class="cv-player-content" data-tabs>
                <h1 class="cv-player-content__title">{{current_name}}</h1>
                <nav class="cv-tabs">
                    <button class="cv-tabs__btn is-active"
                            data-tab="p-overview">Descripción</button>
                    <button class="cv-tabs__btn"
                            data-tab="p-instructor">Instructor</button>
                    <button class="cv-tabs__btn"
                            data-tab="p-resources">Recursos</button>
                </nav>

                <div class="cv-tab-panel is-active" data-tab="p-overview">
                    {{#has_description}}
                        <p class="cv-player-content__description">
                            {{description}}
                        </p>
                    {{/has_description}}
                    {{#personalizados}}
                        {{#course_long_description}}
                            <p class="cv-player-content__description">
                                {{course_long_description}}
                            </p>
                        {{/course_long_description}}
                    {{/personalizados}}
                </div>

                <div class="cv-tab-panel" data-tab="p-instructor">
                    {{#instructores}}
                        <div class="cv-instructor-card">
                            <div class="cv-instructor-card__header">
                                <div class="cv-instructor-card__avatar"
                                     style="background:url({{avatarurl}}) center/cover"></div>
                                <div>
                                    <h3 class="cv-instructor-card__name">{{fullname}}</h3>
                                </div>
                            </div>
                            <div class="cv-instructor-card__stats">
                                <div class="cv-instructor-card__stat">
                                    <strong>{{coursecount}}</strong> cursos
                                </div>
                                <div class="cv-instructor-card__stat">
                                    <strong>{{studentcount}}</strong> estudiantes
                                </div>
                            </div>
                            {{#hasbio}}
                                <p class="cv-instructor-card__bio">{{{bio}}}</p>
                            {{/hasbio}}
                        </div>
                    {{/instructores}}
                </div>

                <div class="cv-tab-panel" data-tab="p-resources">
                    <p style="font-size:1.4rem;color:#6a6f73;padding:2.4rem 0">
                        Recursos adicionales de esta lección.
                    </p>
                </div>

            </div>

        {{/show_player}}

        {{> local_catalog/footer}}

    </div>

    {{! ── SIDEBAR — solo vídeos ──────────────────────────────────────────── }}
    <aside class="cv-player-layout__sidebar">
        <div class="cv-player-sidebar">
            <div class="cv-player-sidebar__header">Contenido del curso</div>

            <div class="cv-player-sidebar__section">
                {{#sections_videos}}
                    <button class="cv-player-sidebar__section-header
                               {{#section_active}}is-active{{/section_active}}"
                            aria-expanded="{{#isopen}}true{{/isopen}}{{^isopen}}false{{/isopen}}">
                        <div>
                            <div class="cv-player-sidebar__section-title">{{name}}</div>
                            <div class="cv-player-sidebar__section-meta">
                                {{progress_text}} completadas
                            </div>
                        </div>
                        <svg class="cv-player-sidebar__section-arrow"
                             viewBox="0 0 24 24" width="16" height="16">
                            <path d="M6 9l6 6 6-6" stroke="currentColor"
                                  stroke-width="2" stroke-linecap="round" fill="none"/>
                        </svg>
                    </button>

                    <div class="cv-player-sidebar__lessons
                        {{#isopen}}is-open{{/isopen}}">
                        {{#activities}}
                            <a href="{{playerurl}}"
                               class="cv-player-sidebar__lesson
                              {{#is_active}}is-current{{/is_active}}">
                                <div class="cv-player-sidebar__check">
                                    <svg viewBox="0 0 24 24" width="10" height="10">
                                        <path d="M20 6L9 17l-5-5" stroke="currentColor"
                                              stroke-width="2.5" stroke-linecap="round"
                                              fill="none"/>
                                    </svg>
                                </div>
                                <div class="cv-player-sidebar__lesson-info">
                                    <div class="cv-player-sidebar__lesson-title">
                                        {{name}}
                                    </div>
                                    <div class="cv-player-sidebar__lesson-meta">
                                        <svg viewBox="0 0 24 24" width="12" height="12">
                                            <circle cx="12" cy="12" r="10"/>
                                            <polygon points="10,8 16,12 10,16 10,8"
                                                     fill="currentColor"/>
                                        </svg>
                                        Vídeo
                                    </div>
                                </div>
                            </a>
                        {{/activities}}
                    </div>

                {{/sections_videos}}
            </div>

        </div>
    </aside>

</div>
